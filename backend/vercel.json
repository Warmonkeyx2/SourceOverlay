{
  "buildCommand": "npm install && npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "functions": {
    "src/**/*.ts": {
      "maxDuration": 30
    }
  },
  "env": {
    "NODE_ENV": "production",
    "PORT": "4501",
    "JWT_EXPIRY": "10m",
    "MFA_ISSUER": "SourceNinja",
    "MFA_WINDOW": "2"
  }
}
